rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Anyone can view the public fundraising total and donor list.
    // Only the explicitly configured administrator UID can create, edit, or delete records.
    function isAdmin() {
      return request.auth != null
        && request.auth.uid == "PASTE_ADMIN_AUTH_UID_HERE";
    }
    match /donations/{donationId} {
      allow read: if true;
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['name','amount','date','createdAt','updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.amount is int
        && request.resource.data.amount > 0
        && request.resource.data.amount <= 1000000000
        && request.resource.data.date is string;
      allow update: if isAdmin()
        && request.resource.data.keys().hasOnly(['name','amount','date','createdAt','updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.amount is int
        && request.resource.data.amount > 0
        && request.resource.data.amount <= 1000000000
        && request.resource.data.date is string;
      allow delete: if isAdmin();
    }
  }
}